# infra/deploy.sh 実行後に自動で埋まる（T03）。手動で設定する場合はこのファイルを .env にコピーする。

# Microsoft Foundry
FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com
DECISION_DEPLOYMENT=decision-eval
EMBED_DEPLOYMENT=embed
GEN_DEPLOYMENT=gen
JUDGE_DEPLOYMENT=judge

# Azure Database for PostgreSQL Flexible Server（Entra 認証）
PG_HOST=<server>.postgres.database.azure.com
PG_DB=ragdb
PG_USER=<Entraユーザー>
