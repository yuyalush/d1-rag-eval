# このファイルを .env にコピーして使う。FOUNDRY_ENDPOINT は infra/deploy.sh 実行後に自動で埋まる。

# Microsoft Foundry（East US 2）
FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com
DECISION_DEPLOYMENT=decision-eval
EMBED_DEPLOYMENT=embed
GEN_DEPLOYMENT=gen
JUDGE_DEPLOYMENT=judge

# PostgreSQL
# 開発中はローカル Docker（docker compose up -d）。PG_PASSWORD を設定するとパスワード認証になる。
PG_HOST=localhost
PG_DB=ragdb
PG_USER=rag
PG_PASSWORD=rag
# 最終評価で Azure（Japan East）を使うときは PG_PASSWORD を空にし、Entra 認証にする:
# PG_HOST=<server>.postgres.database.azure.com
# PG_USER=<Entraユーザー>
